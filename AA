#!/usr/bin/env python3
import json
import glob
import argparse
import os
import xml.etree.ElementTree as ET
import matplotlib.pyplot as plt

# Dynamic integration of your custom simulation data reader module
try:
    import SimDataReader
    HAS_READER = True
    print("[INFO] Successfully incorporated pipeline module: SimDataReader.py")
except ImportError:
    HAS_READER = False
    print("[WARN] SimDataReader.py fallback mode active (using native JSON parsing).")

def parse_detector_xml(filename):
    """Extracts structural tracking names and dimensions from simulation XML layouts"""
    if not os.path.exists(filename):
        print(f"[WARN] Structural file {filename} missing. Using framework array layout.")
        return None
    try:
        tree = ET.parse(filename)
        root = tree.getroot()
        detectors = {}
        # Parse XML elements (handles common structure variations like <detector name="..."> or tags)
        for det in root.findall('.//detector') + root.findall('.//Detector'):
            det_id = det.get('id') or det.findtext('id')
            det_name = det.get('name') or det.findtext('name')
            if det_id is not None:
                detectors[int(det_id)] = det_name or f"Detector_{det_id}"
        print(f"[INFO] Successfully incorporated spatial configurations from {filename}")
        return detectors
    except Exception as e:
        print(f"[WARN] Error decoding XML metadata from {filename}: {e}")
        return None

def analyze_vrml_frames():
    """Scans and counts visual track event blocks generated by Geant4 (*.wrl)"""
    wrl_files = glob.glob("g4_*.wrl")
    total_frames = len(wrl_files)
    print(f"[INFO] Incorporating geometric layout vectors: Found {total_frames} data frames (*.wrl)")
    
    # Optional deep parsing: Count specific geometric point components inside VRML files
    total_visual_tracks = 0
    for file in wrl_files:
        try:
            with open(file, 'r', errors='ignore') as f:
                content = f.read()
                # Geant4 visualizations mark tracks with PointSet or Coordinate3 nodes
                total_visual_tracks += content.count("PointSet") + content.count("Coordinate3")
        except Exception:
            pass
    if total_frames > 0:
         print(f"[INFO] Analyzed visual scene graph tracks: {total_visual_tracks} nodes localized across files.")
    return total_frames

def main():
    parser = argparse.ArgumentParser(description="G4HodoscopeSimulator Analytical Engine")
    parser.add_argument('-f', '--file', default='output.json', help='Main simulation run track dataset')
    args = parser.parse_args()

    print("--- 3-Panel Detector Summary Execution ---")

    # 1. Incorporate Run Configurations (G4HodoscopeSimulator.json)
    energy_scale = 1.0
    beam_particle = "e-"
    try:
        with open("G4HodoscopeSimulator.json", "r") as config_file:
            config_data = json.load(config_file)
            print("[INFO] Incorporated run configurations from G4HodoscopeSimulator.json")
            # Extract baseline metrics if defined in your config environment
            energy_scale = config_data.get("beam_energy_mev", 1.0)
            beam_particle = config_data.get("particle_type", "e-")
    except (FileNotFoundError, json.JSONDecodeError):
        print("[WARN] G4HodoscopeSimulator.json inaccessible. Defaulting calibration coefficients.")

    # 2. Incorporate Structural Mappings (DetectorList.xml & DetectorProperties.xml)
    det_list_map = parse_detector_xml("DetectorList.xml") or {}
    det_props_map = parse_detector_xml("DetectorProperties.xml") or {}
    
    # Merge identified identities (Fallback to exact hardcoded terminal naming schemas if empty)
    detector_names = {
        0: det_list_map.get(0) or det_props_map.get(0) or "eHodoscope",
        1: det_list_map.get(1) or det_props_map.get(1) or "eCounter",
        2: det_list_map.get(2) or det_props_map.get(2) or "eHodoscope"
    }

    # 3. Incorporate Event Layout Frames (g4_*.wrl)
    total_wrl_count = analyze_vrml_frames()

    # 4. Incorporate and Parse the core output telemetry (output.json)
    try:
        print(f"[INFO] Accessing Simulated data stream from file: {args.file}")
        
        # If your SimDataReader module has a specific load function, use it dynamically
        if HAS_READER and hasattr(SimDataReader, 'load_data'):
            sim_raw_data = SimDataReader.load_data(args.file)
        else:
            with open(args.file, "r") as f:
                sim_raw_data = json.load(f)

        # Map dynamic outputs directly from data keys, fallback to 0 if no hits recorded
        hits_data = {
            0: sim_raw_data.get("detector_0_hits", sim_raw_data.get("detector_0", 0)),
            1: sim_raw_data.get("detector_1_hits", sim_raw_data.get("detector_1", 0)),
            2: sim_raw_data.get("detector_2_hits", sim_raw_data.get("detector_2", 0))
        }
    except (FileNotFoundError, json.JSONDecodeError) as e:
        print(f"[ERROR] Critical dependency failure processing '{args.file}': {e}")
        return

    # 5. Execute calculations and compile terminal reports
    processed_results = {}
    for det_id in sorted(detector_names.keys()):
        name = detector_names[det_id]
        hits = hits_data.get(det_id, 0)
        
        # Calculate deposited energy scaled by calibration parameters
        deposited_energy = hits * 0.25 * energy_scale 
        
        print(f"[INFO] Accessing Simulated data for {name} (ID = {det_id})")
        print(f"[WARN] {name} (ID {det_id}) recorded {hits} hits. Filling with {deposited_energy:.1f} MeV.")
        
        label_key = f"Det {det_id}: {name}"
        processed_results[label_key] = hits

    print("[INFO] 3-panel data processing complete.")

    # 6. Generate, render, and output the compiled result chart
    plt.figure(figsize=(9, 5))
    colors = ['#1f77b4', '#2ca02c', '#ff7f0e']
    
    bars = plt.bar(processed_results.keys(), processed_results.values(), color=colors, edgecolor='black', width=0.6)
    
    # Dynamic chart detailing derived context
    plt.title(f"Compiled Detector Response Profile\n(Source: {args.file} | Tracks: {total_wrl_count} frames)", fontsize=12, fontweight='bold')
    plt.ylabel("Accumulated Hits (Count)", fontsize=11)
    plt.xlabel("Target Detection Arrays", fontsize=11)
    plt.grid(axis='y', linestyle='--', alpha=0.7)
    
    # Add data counters on top of every bar
    for bar in bars:
        yval = bar.get_height()
        plt.text(bar.get_x() + bar.get_width()/2.0, yval + 0.05, f"{int(yval)}", ha='center', va='bottom', fontweight='bold')

    output_plot = "detector_response.png"
    plt.tight_layout()
    plt.savefig(output_plot, dpi=150)
    print(f"[INFO] Plot successfully generated and saved as '{output_plot}'")

if __name__ == "__main__":
    main()
